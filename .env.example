# Minecraft Java server (prefer 127.0.0.1 — localhost can fail on this machine)
MINECRAFT_HOST=127.0.0.1
MINECRAFT_PORT=25565
MINECRAFT_VERSION=1.21.11
MINECRAFT_AUTH_MODE=offline
MINECRAFT_USERNAME=Atlas

# Orchestrator / dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
DATABASE_PATH=./data/civilization.sqlite

# Simulation
SIM_CITIZEN_COUNT=5
SIM_TICK_MS=1500
AUTO_START_PAPER=true
SIM_ASSIGN_WORK_ROLES=false

# LLM cognition (optional — simulation runs without a local model)
# Providers: ollama | nvidia | gemini | openai_compatible | heuristic | none
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_FALLBACK_PROVIDER=heuristic
LLM_FALLBACK_MODEL=
LLM_ENABLED=false
LLM_TIMEOUT_MS=45000
LLM_MAX_RETRIES=2
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
LLM_COOLDOWN_MS=60000

# NVIDIA NIM / NVIDIA Build (OpenAI-compatible). Never commit real keys.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Generic OpenAI-compatible endpoint (optional)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
