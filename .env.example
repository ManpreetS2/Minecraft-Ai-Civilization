# LEGACY DEVELOPMENT DEFAULTS (November 1, 2026): These settings still initialize older
# five-citizen / three-citizen local workflows. They do NOT configure the locked 2v2 demo.
# For current goals and release gates see public project.md and docs/CURRENT_STATUS_2026-11-01.md.
# The planned Paper 1.21.6 target is NOT a tested version upgrade; do not change the
# MINECRAFT_VERSION or start Paper just to follow documentation. Cloud billing stays disabled.

# Minecraft Java server (prefer 127.0.0.1 — localhost can fail on this machine)
MINECRAFT_HOST=127.0.0.1
MINECRAFT_PORT=25565
MINECRAFT_VERSION=1.21.11
MINECRAFT_AUTH_MODE=offline
MINECRAFT_USERNAME=Atlas

# Orchestrator / dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
DATABASE_PATH=./data/civilization.sqlite
# Live-civ default above. Do not point WORLD-LAB at that file and do not copy it.
# Proposed after the user approves docs/GREEN_WORLD_LAB_SQLITE_PLAN.md:
# DATABASE_PATH=./data/world-lab-civilization.sqlite

# Simulation
SIM_CITIZEN_COUNT=5
SIM_TICK_MS=1500
SIM_PERMADEATH_ENABLED=false
# Experiment 1: citizens are not assigned permanent jobs by roster order.
# Set true only for legacy tests that still need wood/food/stone/tools/build roles.
SIM_ASSIGN_WORK_ROLES=false
HUMAN_DIRECTIVES_ENABLED=true
AUTO_START_PAPER=true

# LLM cognition (optional — simulation runs without a local model)
# Providers: ollama | openai | llamacpp | none
LLM_PROVIDER=ollama
LLM_ENABLED=false
OLLAMA_ENABLED=false
OLLAMA_HOST=http://127.0.0.1:11434
# Legacy fallback; routine deliberation uses OLLAMA_ROUTINE_MODEL
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_ROUTINE_MODEL=qwen3.5:9b
OLLAMA_REFLECTION_MODEL=gpt-oss:20b
OLLAMA_CONTEXT_SIZE=8192
OLLAMA_MAX_CONCURRENCY=1
OLLAMA_TIMEOUT_MS=45000
OLLAMA_REFLECTION_ENABLED=false
LLM_COOLDOWN_MS=60000

# Cloud OpenAI Responses API (Mission 011) — DISABLED by default.
# OLLAMA_ENABLED never turns cloud billing on. Requires ALL of:
#   LLM_PROVIDER=openai, LLM_ENABLED=true, CLOUD_LLM_ENABLED=true, OPENAI_API_KEY set.
# Do not commit real API keys. Consumer ChatGPT subscriptions are not API credentials.
CLOUD_LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Leave empty for the official API and loopback mocks. Any other HTTPS base URL receives the API key,
# so it also requires its exact host[:port] here. The budget still uses OpenAI's prices for it.
OPENAI_CUSTOM_ENDPOINT_HOST=
CLOUD_TIMEOUT_MS=30000
# Upper bound on input tokens, measured as UTF-8 bytes of the request. Larger requests are refused unsent.
CLOUD_MAX_INPUT_TOKENS=16000
CLOUD_MAX_OUTPUT_TOKENS=128
CLOUD_MAX_CONCURRENCY=1
CLOUD_MAX_REQUESTS_PER_RUN=60
CLOUD_SPEND_ALLOWANCE_USD=1.0
CLOUD_MAX_RETRIES=1
# Used when cost policy stops cloud calls: none, heuristic, or ollama (loopback OLLAMA_HOST only).
CLOUD_FALLBACK_PROVIDER=none

# Mission 012 — opt-in three-citizen demonstration (Atlas, Maya, Theo).
# Default `none` preserves historical five-citizen configurations.
# Set DEMO_PROFILE=three_citizen only when preparing the first survival demo.
# Does not auto-start simulation. Validate with validateThreeCitizenDemo().
DEMO_PROFILE=none
DEMO_PERSONALITY_SEED=civ-demo-2026
DEMO_RUN_MINUTES=60
DEMO_BULLETIN_TARGET_TOKENS=200
# For three_citizen also set: SIM_CITIZEN_COUNT=3, SIM_ASSIGN_WORK_ROLES=false,
# SIM_PERMADEATH_ENABLED=false. keepInventory=false must be enforced on the live server
# during Gate B preparation (not assumed from this file alone).

# TEST-ONLY mechanics probe (MechProbe). Never a citizen.
# pnpm --filter @civ/orchestrator mechanics enables the probe for that run.
MECHANICS_PROBE_ENABLED=false
MECHANICS_PROBE_KEEP_ALIVE=false
MECHANICS_PROBE_USERNAME=MechProbe

# Isolated 3x3 farm harness (FarmProbe). Never 25565/25566. Never auto-start Paper.
# MECHANICS_FARM_TEST_ENABLED=true
# FARM_TEST_ALLOW_WORLD_MUTATION=true
# FARM_TEST_PORT=25567
# FARM_TEST_RCON_PORT=25577

# Isolated MineProbe harness. Prepared only until RED/BLUE/user approve a bounded site.
# Never 25565/25566. Never Site C / farm pad / H1. Never /setblock ore. Never pnpm sim:start.
# MECHANICS_MINE_TEST_ENABLED=true
# MINE_TEST_ALLOW_WORLD_MUTATION=true
# MINE_TEST_RED_APPROVED=true
# MINE_TEST_BLUE_IDLE=true
# MINE_TEST_USER_APPROVED=true
# MINE_TEST_PORT=25567
# MINE_TEST_RCON_PORT=25577
# MINE_TEST_ORIGIN=x,y,z
# MINE_TEST_CHEST=x,y,z
# MINE_TEST_RADIUS=16
# MINE_TEST_RESOURCE=coal

# Isolated FishProbe harness. Prepared only until RED/BLUE/user approve a shore.
# Never 25565/25566. Never Site C / farm / H1 shore / coal pocket. Never /give fish.
# MECHANICS_FISH_TEST_ENABLED=true
# FISH_TEST_ALLOW_WORLD_MUTATION=true
# FISH_TEST_RED_APPROVED=true
# FISH_TEST_BLUE_IDLE=true
# FISH_TEST_USER_APPROVED=true
# FISH_TEST_PORT=25567
# FISH_TEST_RCON_PORT=25577
# FISH_TEST_ORIGIN=x,y,z
# FISH_TEST_CHEST=x,y,z
# FISH_TEST_RADIUS=8
# FISH_TEST_CASTS=1
# FISH_TEST_TIMEOUT_MS=60000
# FISH_TEST_RETURN_HOME=true
# FISH_TEST_HOME=x,y,z

# Same-pond two-citizen fishing (Kai + Atlas). Prepared only. Never pnpm sim:start.
# MECHANICS_TWO_FISH_TEST_ENABLED=true
# TWO_FISH_ALLOW_WORLD_MUTATION=true
# TWO_FISH_RED_APPROVED=true
# TWO_FISH_BLUE_SHARED=true
# TWO_FISH_USER_APPROVED=true
# TWO_FISH_KAI_ORIGIN=x,y,z
# TWO_FISH_ATLAS_ORIGIN=x,y,z
# TWO_FISH_KAI_CHEST=x,y,z
# TWO_FISH_ATLAS_CHEST=x,y,z
# TWO_FISH_TIMEOUT_MS=420000
