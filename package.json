{
  "name": "minecraft-ai-civilization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous artificial civilization in a shared Minecraft Java world",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @civ/orchestrator dev",
    "atlas": "pnpm --filter @civ/orchestrator atlas",
    "sim:start": "pnpm --filter @civ/orchestrator start",
    "world-lab:one-citizen": "pnpm --filter @civ/orchestrator world-lab:one-citizen",
    "mechanics:demo": "pnpm --filter @civ/orchestrator mechanics:demo",
    "mechanics:farm": "pnpm --filter @civ/orchestrator mechanics:farm",
    "mechanics:home": "pnpm --filter @civ/orchestrator mechanics:home",
    "mechanics:move": "pnpm --filter @civ/orchestrator mechanics:move",
    "mechanics:oak-log": "pnpm --filter @civ/orchestrator mechanics:oak-log",
    "mechanics:return-home": "pnpm --filter @civ/orchestrator mechanics:return-home",
    "mechanics:curfew": "pnpm --filter @civ/orchestrator mechanics:curfew",
    "mechanics:mine": "pnpm --filter @civ/orchestrator mechanics:mine",
    "mechanics:fish": "pnpm --filter @civ/orchestrator mechanics:fish",
    "mechanics:two-fish": "pnpm --filter @civ/orchestrator mechanics:two-fish",
    "mechanics:two-probe": "pnpm --filter @civ/orchestrator mechanics:two-probe",
    "sim:reset-dev": "pnpm --filter @civ/orchestrator reset-dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "experiment:preflight": "tsx scripts/experiment-preflight.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
