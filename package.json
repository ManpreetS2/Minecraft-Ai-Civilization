{
  "name": "minecraft-ai-civilization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous artificial civilization in a shared Minecraft Java world",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @civ/orchestrator dev",
    "atlas": "pnpm --filter @civ/orchestrator atlas",
    "sim:start": "pnpm --filter @civ/orchestrator start",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
